# SafariDesk backend environment

# App
APP_NAME=SafariDesk
APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1
AUTH_EMAIL_DELIVERY_MODE=direct

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/safaridesk

# Redis / Celery
REDIS_URL=redis://localhost:6379

# M-Pesa Daraja
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORT_CODE=174379
MPESA_PASSKEY=
# Daraja does not sign its callback requests. MPESA_CALLBACK_SECRET is the
# only thing stopping anyone from forging a "payment succeeded" POST to
# mpesa-callback — set it to a long random value and include it as the
# `secret` query parameter in MPESA_CALLBACK_URL below.
MPESA_CALLBACK_SECRET=replace-with-a-long-random-secret
MPESA_CALLBACK_URL=http://localhost:8000/api/v1/payments/mpesa-callback?secret=replace-with-a-long-random-secret
MPESA_ENVIRONMENT=sandbox

# Africa's Talking
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# SMTP mail
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@safaridesk.com
MAIL_SERVER=smtp.mailtrap.io
MAIL_PORT=587

# Article image storage
IMAGE_STORAGE_BACKEND=local
IMAGE_UPLOAD_DIR=frontend/public/uploads
IMAGE_UPLOAD_MAX_MB=8
IMAGE_MAX_WIDTH=2000
IMAGE_MAX_HEIGHT=1250
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=
