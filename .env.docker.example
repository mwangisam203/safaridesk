# Copy this file to .env.docker for local Docker Compose.

APP_NAME=SafariDesk
APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1
AUTH_EMAIL_DELIVERY_MODE=direct

DATABASE_URL=postgresql://user:password@db:5432/safaridesk
REDIS_URL=redis://redis:6379/0

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=safaridesk

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORT_CODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:8000/api/v1/payments/mpesa-callback
MPESA_ENVIRONMENT=sandbox

AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@safaridesk.com
MAIL_SERVER=smtp.mailtrap.io
MAIL_PORT=587

IMAGE_STORAGE_BACKEND=local
IMAGE_UPLOAD_DIR=/app/frontend/public/uploads
IMAGE_UPLOAD_MAX_MB=8
IMAGE_MAX_WIDTH=2000
IMAGE_MAX_HEIGHT=1250
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=

VITE_API_BASE_URL=
